# ---- API UTDRS (self-service) ----
# Base URL endpoint UTDRS yang dipakai halaman welcome untuk:
#   - {base}/self-checkin   (tombol Check in)
#   - {base}/self-register  (tombol Daftar)
# Tanpa trailing slash. JS menggabungkan dengan path `/self-checkin` & `/self-register`.
API_UTDRS_BASE=http://localhost:8081/server/darah

# Kredensial akun platform untuk memperoleh JWT (login/platform).
# Dipakai server-side oleh Welcome::self_checkin / self_register — token TIDAK
# pernah dikirim ke browser. Gunakan akun layanan khusus (bukan akun pribadi).
UTDRS_PLATFORM_NIP=
UTDRS_PLATFORM_PASSWORD=

# Token JWT statis untuk /server/darah/* (DIUTAMAKAN bila diisi).
# /server memvalidasi NIP di DB "default", sedangkan login/platform (grup prima)
# di DB "prodDB" — token hasil login prima TIDAK valid untuk /server. Tempel token
# yang sudah terbukti bekerja (mis. dari Insomnia). Tanpa prefix "Bearer".
UTDRS_BEARER_TOKEN=
