FROM node:18-alpine

WORKDIR /app

# Salin package.json dari folder nodejs
COPY public/nodejs/package*.json ./

# Install dependencies (hanya production)
RUN npm install --production && npm cache clean --force

# Salin seluruh konten nodejs ke /app
COPY public/nodejs/ .

EXPOSE 8085

# Healthcheck untuk Docker orchestration
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8085/health || exit 1

CMD ["node", "server.js"]