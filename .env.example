# ====================================
# Realtime Antrian - Environment Config
# ====================================
# Copy this file to .env and adjust values as needed
# cp .env.example .env

# ----- CODEIGNITER 3 ----
CI_ENV=development

# ----- Redis -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=password_redis

# ----- MySQL -----
DB_HOST=127.0.0.1
DB_USER=antrian_db
DB_PASS=password_db
DB_NAME=antrian_db
MYSQL_ROOT_PASSWORD=password_root

# ----- Ports -----
PHP_PORT=9080
NODEJS_PORT=9085
MYSQL_PORT=3306
REDIS_EXT_PORT=6379

# ----- Socket.IO -----
# URL absolut ke service Socket.IO. Kosongkan di produksi (agar view pakai
# same-origin via reverse proxy Nginx/Apache). Untuk dev Windows tanpa proxy,
# isi dengan endpoint Node.js langsung, misal:
# SOCKET_URL=http://127.0.0.1:8085

# CORS origin untuk Socket.IO (dipisah koma bila lebih dari satu).
# Default: https://antrian.rspersahabatan.co.id,http://10.0.20.244:8084
# CORS_ORIGIN=https://antrian.rspersahabatan.co.id,http://10.0.20.244:8084
SOCKET_URL=

# ---- API BASIC AUTH ----
USER_API=
PASS_API=

# ---- SERVER TTS ----
# URL Dari Service Aplikasi EDGE TTS Yang Dijalankan
# SOURCE: https://github.com/rsuppersahabatan/Edge-TTS-API
TTS_API_BASE=
TTS_VOICE=
TTS_RATE=

# ---- API UTDRS (self-service) ----
# Base URL endpoint UTDRS yang dipakai halaman welcome untuk:
#   - {base}/self-checkin   (tombol Check in)
#   - {base}/self-register  (tombol Daftar)
# Tanpa trailing slash. JS menggabungkan dengan path `/self-checkin` & `/self-register`.
API_UTDRS_BASE=http://localhost:8081/server/darah

# Kredensial akun platform untuk memperoleh JWT (login/platform) secara server-side.
UTDRS_PLATFORM_NIP=
UTDRS_PLATFORM_PASSWORD=

# Token JWT statis untuk /server/darah/* (diutamakan bila diisi). Tanpa prefix "Bearer".
UTDRS_BEARER_TOKEN=