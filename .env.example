# ====================================
# Realtime Antrian - Environment Config
# ====================================
# Copy this file to .env and adjust values as needed
# cp .env.example .env

# ----- CODEIGNITER 3 ----
CI_ENV=development

# ----- Redis -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=password_redis

# ----- MySQL -----
DB_HOST=127.0.0.1
DB_USER=antrian_db
DB_PASS=password_db
DB_NAME=antrian_db
MYSQL_ROOT_PASSWORD=password_root

# ----- Ports -----
PHP_PORT=9080
NODEJS_PORT=9085
MYSQL_PORT=3306
REDIS_EXT_PORT=6379

# ----- Socket.IO -----
# URL absolut ke service Socket.IO. Kosongkan di produksi (agar view pakai
# same-origin via reverse proxy Nginx/Apache). Untuk dev Windows tanpa proxy,
# isi dengan endpoint Node.js langsung, misal:
# SOCKET_URL=http://127.0.0.1:8085
SOCKET_URL=

# ---- API BASIC AUTH ----
USER_API=
PASS_API=

# ---- SERVER TTS ----
# URL Dari Service Aplikasi EDGE TTS Yang Dijalankan
# SOURCE: https://github.com/rsuppersahabatan/Edge-TTS-API
TTS_API_BASE=
TTS_VOICE=
TTS_RATE=
